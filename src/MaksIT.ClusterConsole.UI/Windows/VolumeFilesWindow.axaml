<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MaksIT.ClusterConsole.UI.ViewModels.Storage"
        xmlns:shared="using:MaksIT.ClusterConsole.Shared"
        xmlns:editor="using:MaksIT.ClusterConsole.UI.Controls.Editor"
        xmlns:footer="using:MaksIT.ClusterConsole.UI.Controls.Footer"
        x:Class="MaksIT.ClusterConsole.UI.Windows.VolumeFilesWindow"
        x:DataType="vm:VolumeFilesViewModel"
        Title="{Binding WindowTitle}"
        Icon="/Assets/icon.ico"
        Width="960"
        Height="640"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12">
      <TextBlock Text="{Binding WindowTitle}" FontSize="18" FontWeight="SemiBold" />
      <ComboBox HorizontalAlignment="Stretch"
                ItemsSource="{Binding Mounts}"
                SelectedItem="{Binding SelectedMount}"
                PlaceholderText="No running pod mounts this PVC">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="shared:VolumeMountTarget">
            <TextBlock Text="{Binding Caption}" TextTrimming="CharacterEllipsis" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Text="{Binding Status}" Classes="hint" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
    </StackPanel>

    <footer:WindowFooter DockPanel.Dock="Bottom"
                         Items="{Binding FooterItems}"
                         Margin="0,12,0,0" />

    <Grid ColumnDefinitions="280,12,*">
      <ListBox ItemsSource="{Binding Entries}"
               SelectedItem="{Binding SelectedEntry}"
               Background="#25282c"
               Foreground="#e6e6e6"
               DoubleTapped="OnEntriesDoubleTapped">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="shared:VolumeEntry">
            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
              <TextBlock Text="{Binding Display}" Foreground="#e6e6e6" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" Text="{Binding SizeText}" Classes="hint" Margin="12,0,0,0" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding EditorHint}"
                   Classes="hint"
                   Margin="0,0,0,8"
                   TextWrapping="Wrap" />
        <editor:SyntaxTextEditor Text="{Binding EditorText}"
                                   FileName="{Binding OpenFilePath}"
                                   IsReadOnly="{Binding EditorReadOnly}" />
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
