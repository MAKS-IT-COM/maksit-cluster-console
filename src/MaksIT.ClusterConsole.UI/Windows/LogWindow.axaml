<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MaksIT.ClusterConsole.UI.ViewModels"
        x:Class="MaksIT.ClusterConsole.UI.Windows.LogWindow"
        x:DataType="vm:LogViewModel"
        Width="860"
        Height="560"
        MinWidth="560"
        MinHeight="360"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/icon.ico"
        Title="Logs">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8"
                Margin="0,12,0,0">
      <TextBlock Text="{Binding CopyStatus}"
                 Classes="hint"
                 VerticalAlignment="Center"
                 Margin="0,0,8,0" />
      <Button Content="Copy"
              Click="OnCopyClick" />
      <Button Content="Close"
              Padding="16,8"
              Click="OnCloseClick"
              IsDefault="True"
              IsCancel="True" />
    </StackPanel>
    <ComboBox DockPanel.Dock="Top"
              ItemsSource="{Binding Files}"
              SelectedItem="{Binding SelectedFile}"
              Margin="0,0,0,12" />
    <TextBox Text="{Binding Report}"
             Classes="error-dump"
             IsReadOnly="True"
             AcceptsReturn="True"
             TextWrapping="NoWrap"
             ScrollViewer.HorizontalScrollBarVisibility="Auto"
             ScrollViewer.VerticalScrollBarVisibility="Auto" />
  </DockPanel>
</Window>
