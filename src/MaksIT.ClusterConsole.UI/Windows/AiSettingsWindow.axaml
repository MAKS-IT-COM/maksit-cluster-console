<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:footer="using:MaksIT.ClusterConsole.UI.Controls.Footer"
        xmlns:vm="using:MaksIT.ClusterConsole.UI.ViewModels"
        x:Class="MaksIT.ClusterConsole.UI.Windows.AiSettingsWindow"
        x:DataType="vm:AiSettingsViewModel"
        Title="AI"
        Icon="/Assets/icon.ico"
        Width="480"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <StackPanel Margin="16" Spacing="10">
    <TextBlock Text="Local Ollama" FontSize="18" FontWeight="SemiBold" />
    <TextBlock Classes="hint" TextWrapping="Wrap"
               Text="Chat stays on this machine and talks to a local Ollama server. Any GPU is fine. Repairs work best with qwen3:14b or larger (qwen3:32b, qwen3-coder:30b)." />
    <CheckBox Content="Enable chat" IsChecked="{Binding EnabledChat}" />
    <CheckBox Content="Allow the assistant to change the cluster"
              IsChecked="{Binding AgentEnabled}"
              IsEnabled="{Binding EnabledChat}" />
    <Grid ColumnDefinitions="88,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
      <TextBlock Text="Endpoint" Classes="hint" VerticalAlignment="Center" />
      <TextBox Grid.Column="1" Text="{Binding EndpointText}" />
      <TextBlock Grid.Row="1" Text="Model" Classes="hint" VerticalAlignment="Center" />
      <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ModelText}" />
      <TextBlock Grid.Row="2" Text="Timeout" Classes="hint" VerticalAlignment="Center" />
      <NumericUpDown Grid.Row="2"
                     Grid.Column="1"
                     Value="{Binding TimeoutSeconds}"
                     Minimum="5"
                     Maximum="3600"
                     Increment="15"
                     FormatString="0"
                     ToolTip.Tip="Seconds to wait for each Ollama reply. Chat and the drain note use this." />
    </Grid>
    <footer:WindowFooter Items="{Binding FooterItems}" Margin="0,8,0,0" Spacing="8" />
  </StackPanel>
</Window>
