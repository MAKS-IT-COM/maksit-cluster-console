<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:client="using:MaksIT.ClusterConsole.Client.Cluster"
        xmlns:footer="using:MaksIT.ClusterConsole.UI.Controls.Footer"
        xmlns:vm="using:MaksIT.ClusterConsole.UI.ViewModels.Storage"
        x:Class="MaksIT.ClusterConsole.UI.Windows.RetainReclaimWindow"
        x:DataType="vm:RetainReclaimViewModel"
        Title="{Binding Title}"
        Icon="/Assets/icon.ico"
        Width="640"
        Height="640"
        MinWidth="520"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top"
               Text="{Binding Title}"
               FontSize="18"
               FontWeight="SemiBold"
               Margin="0,0,0,12" />
    <footer:WindowFooter DockPanel.Dock="Bottom"
                         Items="{Binding FooterItems}"
                         Margin="0,12,0,0" />
    <TextBlock DockPanel.Dock="Bottom"
               Text="{Binding Error}"
               Classes="warning"
               TextWrapping="Wrap"
               Margin="0,8,0,0" />

    <ScrollViewer>
      <StackPanel Spacing="10">
        <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" />
        <TextBlock Text="Reading the cluster…" Classes="hint" IsVisible="{Binding ShowLoading}" />

        <StackPanel Spacing="8" IsVisible="{Binding Loaded}">
          <TextBlock Text="{Binding ClassPolicyText}" IsVisible="{Binding ShowClassOption}" />
          <TextBlock Text="New reclaim policy" />
          <ComboBox ItemsSource="{Binding Policies}"
                    SelectedItem="{Binding SelectedPolicy, Mode=TwoWay}"
                    HorizontalAlignment="Left"
                    Width="180" />
          <TextBlock Text="{Binding PolicyHint}" Classes="hint" TextWrapping="Wrap" />
          <TextBlock Classes="hint"
                     TextWrapping="Wrap"
                     Text="This class is the cluster default. That annotation is copied onto the recreated object."
                     IsVisible="{Binding IsDefaultClass}" />
          <CheckBox Content="{Binding ClassOptionText}"
                    IsChecked="{Binding UpdateClass}"
                    IsVisible="{Binding ClassNeedsChange}" />
          <TextBlock Classes="hint"
                     Text="{Binding ClassMatchText}"
                     TextWrapping="Wrap"
                     IsVisible="{Binding ShowClassMatches}" />
          <CheckBox Content="{Binding VolumeOptionText}"
                    IsChecked="{Binding UpdateVolumes}"
                    IsVisible="{Binding ShowVolumeOption}" />
          <TextBlock Classes="hint"
                     TextWrapping="Wrap"
                     Text="No PersistentVolumes use this storage class."
                     IsVisible="{Binding ShowEmptyVolumes}" />

          <ListBox ItemsSource="{Binding Volumes}" MaxHeight="240" IsVisible="{Binding HasVolumes}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="client:ReclaimVolume">
                <Grid ColumnDefinitions="220,*" Margin="0,2">
                  <TextBlock Text="{Binding Name}" />
                  <TextBlock Grid.Column="1" Text="{Binding Detail}" Classes="hint" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel Spacing="6" IsVisible="{Binding HasRecoveryYaml}">
            <TextBlock Text="Recovery YAML" FontWeight="SemiBold" />
            <TextBlock Classes="hint"
                       TextWrapping="Wrap"
                       Text="Create this object after the storage class name is free." />
            <TextBox Text="{Binding RecoveryYaml}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="160"
                     FontFamily="Cascadia Mono, Consolas, Ubuntu Mono, monospace" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
