<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:footer="using:MaksIT.ClusterConsole.UI.Controls.Footer"
        xmlns:vm="using:MaksIT.ClusterConsole.UI.ViewModels.Connections"
        x:Class="MaksIT.ClusterConsole.UI.Windows.ConnectionsWindow"
        x:DataType="vm:ConnectionsViewModel"
        Title="Connections"
        Icon="/Assets/icon.ico"
        Width="780"
        Height="520"
        MinWidth="640"
        MinHeight="400"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12">
      <TextBlock Text="Kubeconfig connections" FontSize="18" FontWeight="SemiBold" />
      <TextBlock Text="{Binding KubeConfigPath}" Classes="hint" TextTrimming="CharacterEllipsis" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
      <TextBlock Text="{Binding Status}" Classes="hint" TextWrapping="Wrap" />
      <footer:WindowFooter Items="{Binding FooterItems}" />
    </StackPanel>

    <Grid ColumnDefinitions="280,12,*">
      <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ConnectionItemViewModel">
            <StackPanel Margin="0,2">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <RadioButton Classes="catalog-current"
                             GroupName="connection-kubectl-current"
                             IsChecked="{Binding IsCurrent, Mode=OneWay}"
                             Command="{Binding UseForKubectlCommand}"
                             VerticalAlignment="Center"
                             ToolTip.Tip="kubectl current-context" />
                <TextBlock Text="kubectl context"
                           Classes="hint"
                           VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="{Binding Subtitle}"
                         Classes="hint"
                         Margin="18,2,0,0"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBox Grid.Column="2"
               Text="{Binding DetailsText}"
               IsReadOnly="True"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               FontFamily="Consolas, Cascadia Mono, monospace" />
    </Grid>
  </DockPanel>
</Window>
