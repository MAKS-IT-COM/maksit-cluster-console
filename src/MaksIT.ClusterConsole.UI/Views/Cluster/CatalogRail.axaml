<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MaksIT.ClusterConsole.UI.ViewModels.Shell"
             x:Class="MaksIT.ClusterConsole.UI.Views.Cluster.CatalogRail"
             x:DataType="vm:MainViewModel"
             IsVisible="{Binding CatalogCollapsed}"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
  <Button Classes="shoulder-rail catalog-rail"
          Margin="4,0,0,0"
          Command="{Binding ToggleCatalogCommand}"
          ToolTip.Tip="Show">
    <StackPanel Spacing="10" HorizontalAlignment="Center">
      <TextBlock Text="›" FontSize="16" HorizontalAlignment="Center" />
      <LayoutTransformControl>
        <LayoutTransformControl.LayoutTransform>
          <RotateTransform Angle="90" />
        </LayoutTransformControl.LayoutTransform>
        <TextBlock Text="Connections" />
      </LayoutTransformControl>
    </StackPanel>
  </Button>
</UserControl>
