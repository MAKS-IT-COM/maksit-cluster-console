<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MaksIT.ClusterConsole.UI.ViewModels.Storage"
             xmlns:s3="using:MaksIT.ClusterConsole.Client.S3"
             xmlns:footer="using:MaksIT.ClusterConsole.UI.Controls.Footer"
             x:Class="MaksIT.ClusterConsole.UI.Views.Cluster.S3BrowserView"
             x:DataType="vm:S3BrowserViewModel">
  <DockPanel Margin="16,8">
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
        <ComboBox ItemsSource="{Binding Targets}"
                  SelectedItem="{Binding SelectedTarget}"
                  HorizontalAlignment="Stretch"
                  IsEnabled="{Binding InputsEnabled}"
                  PlaceholderText="No S3 target">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="s3:S3Target">
              <TextBlock Text="{Binding Caption}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Grid.Column="1" Content="Reload" Command="{Binding ReloadTargetsCommand}" />
        <Button Grid.Column="2" Content="Add target…" Command="{Binding AddTargetCommand}" />
        <Button Grid.Column="3" Content="Edit…" Command="{Binding EditTargetCommand}" />
        <Button Grid.Column="4" Content="Remove" Command="{Binding RemoveTargetCommand}" />
      </Grid>
      <TextBlock Text="{Binding TargetSummary}" Classes="hint" TextWrapping="Wrap" />
      <Grid ColumnDefinitions="*,Auto,160" ColumnSpacing="8">
        <TextBox Text="{Binding PathText}"
                 IsEnabled="{Binding InputsEnabled}"
                 PlaceholderText="Path in the bucket" />
        <Button Grid.Column="1" Content="Open path" Command="{Binding OpenPathCommand}" />
        <TextBox Grid.Column="2"
                 Text="{Binding Filter}"
                 IsEnabled="{Binding InputsEnabled}"
                 PlaceholderText="Filter" />
      </Grid>
      <TextBlock Text="{Binding Status}" Classes="hint" TextWrapping="Wrap" />
    </StackPanel>

    <footer:WindowFooter DockPanel.Dock="Bottom"
                         Items="{Binding FooterItems}"
                         Margin="0,12,0,0" />

    <Grid ColumnDefinitions="220,12,*">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,8">
          <TextBlock Text="Buckets" Classes="hint" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="New" Command="{Binding NewBucketCommand}" />
          <Button Grid.Column="2" Content="Delete" Command="{Binding DeleteBucketCommand}" />
        </Grid>
        <ListBox ItemsSource="{Binding Buckets}"
                 SelectedItem="{Binding SelectedBucket}"
                 IsEnabled="{Binding InputsEnabled}"
                 DoubleTapped="OnBucketDoubleTapped">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="s3:S3Bucket">
              <TextBlock Text="{Binding Caption}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
      <DataGrid Grid.Column="2"
                ItemsSource="{Binding VisibleEntries}"
                SelectedItem="{Binding SelectedEntry}"
                AutoGenerateColumns="False"
                CanUserResizeColumns="True"
                CanUserSortColumns="True"
                GridLinesVisibility="Horizontal"
                IsReadOnly="True"
                IsEnabled="{Binding InputsEnabled}"
                DoubleTapped="OnEntriesDoubleTapped">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" SortMemberPath="Name" />
          <DataGridTextColumn Header="Kind" Binding="{Binding KindText}" Width="90" SortMemberPath="KindText" />
          <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="100" SortMemberPath="Size" />
          <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedText}" Width="150" SortMemberPath="ModifiedSort" />
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </DockPanel>
</UserControl>
