<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MaksIT.ClusterConsole.UI.ViewModels.Shell"

             x:Class="MaksIT.ClusterConsole.UI.Views.Cluster.WorkloadsDashboardView"
             x:DataType="vm:MainViewModel">
  <ScrollViewer Padding="16">
    <StackPanel Spacing="16" MaxWidth="920">
      <TextBlock Text="Workloads" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="{Binding ActivePage.OverviewText}" Classes="hint" />
      <ItemsControl ItemsSource="{Binding ActivePage.Workloads.WorkloadCounts}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:WorkloadKindCount">
            <Button Width="210"
                    Margin="0,0,12,12"
                    Padding="16"
                    Background="#25282c"
                    Command="{Binding ActivateCommand}">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding Title}" Classes="hint" />
                <TextBlock Text="{Binding Count}" FontSize="28" FontWeight="SemiBold" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>