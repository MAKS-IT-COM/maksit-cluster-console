<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.maks_it.clusterconsole</id>
  <name>Cluster Console</name>
  <summary>Kubernetes desktop console</summary>
  <developer id="com.maks_it">
    <name>MaksIT</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>Apache-2.0</project_license>
  <description>
    <p>Browse a Kubernetes cluster from the desktop using your kubeconfig. Apply YAML, follow logs, exec into pods, and manage port-forwards without a browser.</p>
    <p>Settings stay on this computer. Cluster access uses the network and files under the home folder (typically ~/.kube).</p>
    <ul>
      <li>Resource navigator, table, and details pane</li>
      <li>Logs, exec, and port-forwards</li>
      <li>Apply YAML and common operator actions</li>
    </ul>
  </description>
  <launchable type="desktop-id">com.maks_it.clusterconsole.desktop</launchable>
  <provides>
    <id>com.maks_it.ClusterConsole</id>
  </provides>
  <replaces>
    <id>com.maks_it.ClusterConsole</id>
  </replaces>
  <url type="homepage">https://maks-it.com/</url>
  <url type="bugtracker">https://github.com/MAKS-IT-COM/maksit-cluster-console/issues</url>
  <url type="vcs-browser">https://github.com/MAKS-IT-COM/maksit-cluster-console</url>
  <url type="donation">https://www.buymeacoffee.com/maksitcom</url>
  <branding>
    <color type="primary" scheme_preference="light">#33A5CF</color>
    <color type="primary" scheme_preference="dark">#003D7A</color>
  </branding>
  <content_rating type="oars-1.1"/>
  <requires>
    <control>keyboard</control>
    <control>pointing</control>
    <display_length compare="ge">768</display_length>
  </requires>
</component>
