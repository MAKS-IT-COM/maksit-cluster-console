{
  "$schema": "https://json-schema.org/draft-07/schema",
  "title": "MaksIT.ClusterConsole Release Script Settings",
  "description": "Community desktop pipeline. GitHub assets are siblings: portable zip, Windows setup exe, Flatpak. The zip never contains the installer or Flatpak.",
  "plugins": [
    {
      "name": "DotNetReleaseVersion",
      "stageLabel": "build",
      "enabled": true,
      "projectFiles": [
        "..\\..\\..\\src\\MaksIT.ClusterConsole.UI\\MaksIT.ClusterConsole.UI.csproj"
      ]
    },
    {
      "name": "DotNetTest",
      "stageLabel": "test",
      "enabled": true,
      "project": "..\\..\\..\\src\\MaksIT.ClusterConsole.Tests",
      "resultsDir": "..\\..\\..\\test-results"
    },
    {
      "name": "QualityGate",
      "stageLabel": "qualityGate",
      "enabled": true,
      "coverageThreshold": 0,
      "failOnVulnerabilities": true,
      "projectFiles": [
        "..\\..\\..\\src\\MaksIT.ClusterConsole.UI\\MaksIT.ClusterConsole.UI.csproj"
      ]
    },
    {
      "name": "DotNetPublish",
      "stageLabel": "build",
      "enabled": true,
      "projectFiles": [
        "..\\..\\..\\src\\MaksIT.ClusterConsole.UI\\MaksIT.ClusterConsole.UI.csproj"
      ],
      "artifactsDir": "..\\..\\..\\releases",
      "runtimeIdentifiers": [
        "win-x64",
        "linux-x64"
      ],
      "selfContained": true,
      "publishSingleFile": false
    },
    {
      "name": "DotNetCreateArchive",
      "stageLabel": "build",
      "enabled": true,
      "zipNamePattern": "maksit-cluster-console-{version}.zip",
      "portableRuntimeIdentifier": "win-x64"
    },
    {
      "name": "WindowsInstaller",
      "stageLabel": "build",
      "enabled": true,
      "appName": "MaksIT Cluster Console",
      "manufacturer": "MaksIT",
      "installFolderName": "Cluster Console",
      "upgradeCode": "3e45e88a-6524-49cc-88e9-d522d1261b3a",
      "executableName": "MaksIT.ClusterConsole.UI.exe",
      "runtimeIdentifier": "win-x64",
      "installScope": "perMachine",
      "iconPath": "..\\..\\..\\src\\MaksIT.ClusterConsole.UI\\Assets\\icon.ico",
      "exeNamePattern": "maksit-cluster-console-{version}.exe"
    },
    {
      "name": "FlatpakPack",
      "stageLabel": "build",
      "enabled": true,
      "appId": "com.maks_it.ClusterConsole",
      "appName": "MaksIT Cluster Console",
      "command": "maksit-cluster-console",
      "executableName": "MaksIT.ClusterConsole.UI",
      "runtimeIdentifier": "linux-x64",
      "summary": "Kubernetes desktop console",
      "projectLicense": "Apache-2.0",
      "iconPath": "..\\..\\..\\src\\MaksIT.ClusterConsole.UI\\Assets\\icon.png",
      "bundleNamePattern": "maksit-cluster-console-{version}.flatpak",
      "buildBundle": true,
      "attachSourceZip": false,
      "wslDistro": "Debian",
      "whenBuilderMissing": "skip"
    },
    {
      "name": "ReleasePublishGuard",
      "stageLabel": "release",
      "enabled": true,
      "branches": [
        "main"
      ],
      "requireExactTagOnHead": true,
      "tagVersionMustMatchDotNetRelease": true,
      "whenRequirementsNotMet": "skip",
      "requireCleanWorkingTree": false,
      "ensureTagOnRemote": true,
      "remoteName": "origin"
    },
    {
      "name": "GitHub",
      "stageLabel": "release",
      "enabled": true,
      "githubSecret": "GitHub",
      "repository": "https://github.com/MAKS-IT-COM/maksit-cluster-console",
      "releaseNotesFile": "..\\..\\..\\CHANGELOG.md",
      "releaseTitlePattern": "Release {version}",
      "requireReleaseAssets": true
    },
    {
      "name": "CleanupArtifacts",
      "stageLabel": "release",
      "enabled": true,
      "includePatterns": [
        "*"
      ],
      "excludePatterns": [
        "*.zip",
        "*.exe",
        "*.flatpak"
      ]
    }
  ]
}
