{
  "$schema": "https://json-schema.org/draft-07/schema",
  "title": "MaksIT.ClusterConsole Release Script Settings",
  "description": "RepoUtils release pipeline for MaksIT.ClusterConsole Avalonia UI.",
  "plugins": [
    {
      "name": "DotNetReleaseVersion",
      "stageLabel": "build",
      "enabled": true,
      "projectFiles": [
        "..\\..\\..\\src\\MaksIT.ClusterConsole.UI\\MaksIT.ClusterConsole.UI.csproj"
      ]
    },
    {
      "name": "DotNetTest",
      "stageLabel": "test",
      "enabled": true,
      "project": "..\\..\\..\\src\\MaksIT.ClusterConsole.Tests",
      "resultsDir": "..\\..\\..\\test-results"
    },
    {
      "name": "QualityGate",
      "stageLabel": "qualityGate",
      "enabled": true,
      "coverageThreshold": 0,
      "failOnVulnerabilities": true,
      "projectFiles": [
        "..\\..\\..\\src\\MaksIT.ClusterConsole.UI\\MaksIT.ClusterConsole.UI.csproj"
      ]
    },
    {
      "name": "DotNetPublish",
      "stageLabel": "build",
      "enabled": true,
      "projectFiles": [
        "..\\..\\..\\src\\MaksIT.ClusterConsole.UI\\MaksIT.ClusterConsole.UI.csproj"
      ],
      "artifactsDir": "..\\..\\..\\releases"
    },
    {
      "name": "DotNetCreateArchive",
      "stageLabel": "build",
      "enabled": true,
      "zipNamePattern": "maksit-cluster-console-{version}.zip"
    },
    {
      "name": "ReleasePublishGuard",
      "stageLabel": "release",
      "enabled": true,
      "branches": [
        "main"
      ],
      "requireExactTagOnHead": true,
      "tagVersionMustMatchDotNetRelease": true,
      "whenRequirementsNotMet": "skip",
      "requireCleanWorkingTree": false,
      "ensureTagOnRemote": true,
      "remoteName": "origin"
    },
    {
      "name": "GitHub",
      "stageLabel": "release",
      "enabled": true,
      "githubSecret": "GitHub",
      "repository": "https://github.com/MAKS-IT-COM/maksit-cluster-console",
      "releaseNotesFile": "..\\..\\..\\CHANGELOG.md",
      "releaseTitlePattern": "Release {version}"
    },
    {
      "name": "DotNetNuGet",
      "stageLabel": "release",
      "enabled": false,
      "nugetSecret": "NuGet",
      "source": "https://api.nuget.org/v3/index.json"
    },
    {
      "name": "NpmPublish",
      "stageLabel": "release",
      "enabled": false,
      "npmSecret": "Npm",
      "registry": "https://registry.npmjs.org",
      "access": "public",
      "workspaceRoot": "..\\..\\.."
    },
    {
      "name": "DotNetCleanupArtifacts",
      "stageLabel": "release",
      "enabled": true,
      "includePatterns": [
        "*"
      ],
      "excludePatterns": [
        "*.zip"
      ]
    }
  ]
}
